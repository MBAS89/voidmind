# VoidMind Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Admin JWT (RS256 — generate with: ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key)
# Private key for signing (store securely, never expose)
ADMIN_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Public key for verification (can be shared)
ADMIN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ADMIN_JWT_ISSUER=voidmind
ADMIN_JWT_AUDIENCE=voidmind-admin

# Admin credentials
# These are used ONCE to bootstrap the first admin account into the database.
# After bootstrap, you can change the password via the admin API.
# Generate hash with: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
ADMIN_EMAIL=admin@voidmind.local
ADMIN_PASSWORD_HASH=$2b$10$...

# IP Whitelist for admin API (comma-separated CIDR blocks)
ADMIN_IP_WHITELIST=127.0.0.1/32,::1/128

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_REQUEST_TIMEOUT=30000
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_MAX_QUEUE_SIZE=50

# Circuit Breaker
CB_FAILURE_THRESHOLD=3
CB_SUCCESS_THRESHOLD=2
CB_TIMEOUT_MS=30000
CB_RECOVERY_MS=30000

# Model Keep-Alive
KEEP_ALIVE_INTERVAL_MIN=3

# Response Formatting
MAX_RESPONSE_LENGTH=4096
RESPONSE_DISCLAIMER=

# Caching
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIZE=200
RESPONSE_CACHE_TTL_MS=60000
PROMPT_CACHE_SIZE=100
PROMPT_CACHE_TTL_MS=300000

# Ollama Performance Tuning
OLLAMA_NUM_THREADS=0        # 0 = auto (set to your vCPU count for best performance)
OLLAMA_NUM_CTX=4096         # Context window size
OLLAMA_NUM_BATCH=512        # Batch size for prompt processing

# Sessions
SESSION_IDLE_TTL_MS=300000
SESSION_MAX_AGE_MS=1800000
SESSION_MAX_MESSAGES=20
SESSION_MAX_MESSAGE_SIZE=4096

# Rate Limiting
RATE_LIMIT_USER_REQUESTS_PER_MINUTE=60
RATE_LIMIT_ADMIN_REQUESTS_PER_MINUTE=30
RATE_LIMIT_WINDOW_MS=60000

# Security
API_KEY_PREFIX=vm_
CORS_ORIGIN=https://your-app-domain.com
REQUEST_TIMEOUT_MS=30000
MAX_PAYLOAD_SIZE=1mb

# Webhook Alerts (optional)
# Set to Slack/Discord/generic webhook URL for limit and health alerts
WEBHOOK_URL=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
